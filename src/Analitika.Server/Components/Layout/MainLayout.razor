@inherits LayoutComponentBase
@using Analitika.Server.Mostovi
@using Analitika.Server.Servisi
@implements IDisposable
@inject StanjeAplikacije Stanje
@inject MostKlijent Most
@inject NavigationManager Navigacija
@inject PostavkeRestorana Postavke

@*
    Ljuska po uzoru na Vercel: traka i ladica dijele boju platna, razdvaja ih
    hairline. Lijevo su mrvice do stranice, desno restoran za koji se gledaju
    brojke — njegov logo u krugu i ime, kako je upisano u Postavkama.
*@

<MudThemeProvider IsDarkMode="true" Theme="_tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-okvir">
    <MudLayout>
        <MudAppBar Elevation="0" Color="Color.Transparent" Class="app-traka" Gutters="false">
            <div class="d-flex align-center gap-3 px-4" style="width:100%; min-width:0;">
                <button type="button" class="ikona-dugme bez-ruba" aria-label="Meni"
                        aria-expanded="@(_ladica ? "true" : "false")"
                        @onclick="@(() => _ladica = !_ladica)">
                    <MudIcon Icon="@Icons.Material.Outlined.Menu" />
                </button>

                <img src="img/logo.png" alt="Gastroliza" class="app-logo" />

                <div class="app-mrvice d-none d-sm-flex">
                    <span class="kosa" aria-hidden="true">/</span>
                    <span>@TrenutnaStranica</span>
                </div>

                <MudSpacer />

                @if (Stanje.Restoran is { } r)
                {
                    var naziv = Postavke.Naziv(r);
                    var logo = Postavke.Poznate(r.Id)?.Logo;
                    var naVezi = Most.JeNaVezi(r.Id);
                    <a href="postavke" class="restoran-znak" title="@(naVezi ? "Kasa na vezi" : "Kasa nije na vezi") · Postavke restorana">
                        <span class="restoran-ime">@naziv</span>
                        <span class="restoran-krug">
                            @if (!string.IsNullOrEmpty(logo))
                            {
                                <img src="@logo" alt="" />
                            }
                            else
                            {
                                <span class="inicijali">@PostavkeRestorana.Inicijali(naziv)</span>
                            }
                            <span class="tacka-veze @(naVezi ? "na-vezi" : "")" aria-hidden="true"></span>
                        </span>
                    </a>
                }
            </div>
        </MudAppBar>

        @* Ispod md ladica postaje privremena i preklapa sadržaj, umjesto da ga gura udesno. *@
        <MudDrawer @bind-Open="_ladica" Elevation="0" ClipMode="DrawerClipMode.Always"
                   Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
                   Class="app-ladica" Width="232px">
            <NavMenu />
        </MudDrawer>

        <MudMainContent Style="padding-top:56px;">
            <div style="max-width:1320px; margin:0 auto; padding:28px clamp(16px, 3vw, 32px) 48px;">
                @Body
            </div>
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private bool _ladica = true;

    private static readonly Dictionary<string, string> Stranice = new(StringComparer.OrdinalIgnoreCase)
    {
        [""] = "Pregled",
        ["artikli"] = "Artikli",
        ["konobari"] = "Konobari",
        ["normativi"] = "Normativi",
        ["utrosak"] = "Utrošak zaliha",
        ["projekcije"] = "Projekcije",
        ["postavke"] = "Postavke",
        ["povezivanje"] = "Poveži kasu"
    };

    private string TrenutnaStranica
    {
        get
        {
            var put = Navigacija.ToBaseRelativePath(Navigacija.Uri).Split('?', '#')[0].Trim('/');
            return Stranice.TryGetValue(put, out var naziv) ? naziv : "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Stanje.Promjena += Osvjezi;
        Navigacija.LocationChanged += NaNavigaciju;
        Postavke.Promijenjene += NaPostavke;

        if (Stanje.Restoran is { } r) await Postavke.UcitajAsync(r.Id);
    }

    private void NaPostavke(Guid restoran)
    {
        if (restoran == Stanje.Restoran?.Id) InvokeAsync(StateHasChanged);
    }

    private void Osvjezi() => InvokeAsync(StateHasChanged);

    private void NaNavigaciju(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs __) =>
        InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Stanje.Promjena -= Osvjezi;
        Navigacija.LocationChanged -= NaNavigaciju;
        Postavke.Promijenjene -= NaPostavke;
    }

    // Boje grafova stoje u Paleta.cs; ovdje je samo okvir za MudBlazor kontrole.
    private readonly MudTheme _tema = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#3b8bff",
            Secondary = "#8f8f8f",
            Background = "#000000",
            Surface = "#0a0a0a",
            AppbarBackground = "#000000",
            AppbarText = "#ededed",
            DrawerBackground = "#000000",
            DrawerText = "#8f8f8f",
            TextPrimary = "#ededed",
            TextSecondary = "#8f8f8f",
            TextDisabled = "#5f5f5f",
            LinesDefault = "#242424",
            LinesInputs = "#333333",
            Divider = "#242424",
            TableLines = "#242424",
            ActionDefault = "#8f8f8f",
            Success = "#4ccf7d",
            Warning = "#f2a93b",
            Error = "#ff6166",
            Info = "#3b8bff",
            OverlayDark = "rgba(0,0,0,.6)"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
                FontSize = "14px",
                LineHeight = "1.5",
                LetterSpacing = "-0.006em"
            },
            Body1 = new Body1Typography { FontSize = "14px", LineHeight = "1.5", LetterSpacing = "-0.006em" },
            Body2 = new Body2Typography { FontSize = "13px", LineHeight = "1.45", LetterSpacing = "-0.003em" },
            Caption = new CaptionTypography { FontSize = "12px", LineHeight = "1.3", LetterSpacing = "0" },
            Button = new ButtonTypography { FontSize = "13px", FontWeight = "500", LetterSpacing = "-0.005em", TextTransform = "none" }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px", DrawerWidthLeft = "232px", AppbarHeight = "56px" }
    };
}
